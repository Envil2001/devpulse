{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "setupFiles": ["<rootDir>/test/setup.ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "CommonJS",
          "moduleResolution": "Node",
          "resolvePackageJsonExports": false
        }
      }
    ]
  },
  "testEnvironment": "node"
}
