{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "devpulse",
  "displayName": "DevPulse",
  "description": "Automatic worklog and standup draft generator for developers. Tracks coding activity, git commits, and terminal commands locally — then uses AI to write your daily report.",
  "version": "0.0.1",
  "publisher": "devpulse",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Envil2001/devpulse"
  },
  "bugs": {
    "url": "https://github.com/Envil2001/devpulse/issues"
  },
  "homepage": "https://github.com/Envil2001/devpulse#readme",
  "keywords": [
    "time tracking",
    "standup",
    "worklog",
    "productivity",
    "ai",
    "developer tools",
    "git",
    "telemetry"
  ],
  "categories": [
    "Other",
    "Visualization",
    "Machine Learning"
  ],
  "galleryBanner": {
    "color": "#0f0e0d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devpulse.helloWorld",
        "title": "DevPulse: Hello World"
      },
      {
        "command": "devpulse.setApiKey",
        "title": "DevPulse: Set API Key"
      },
      {
        "command": "devpulse.clearApiKey",
        "title": "DevPulse: Clear API Key"
      },
      {
        "command": "devpulse.showMenu",
        "title": "DevPulse: Show Menu"
      },
      {
        "command": "devpulse.pauseTracking",
        "title": "DevPulse: Pause Tracking"
      },
      {
        "command": "devpulse.resumeTracking",
        "title": "DevPulse: Resume Tracking"
      },
      {
        "command": "devpulse.openDashboard",
        "title": "DevPulse: Open Dashboard"
      },
      {
        "command": "devpulse.openSessions",
        "title": "DevPulse: Open Sessions"
      },
      {
        "command": "devpulse.showLog",
        "title": "DevPulse: Show Log"
      },
      {
        "command": "devpulse.showDiagnostics",
        "title": "DevPulse: Show Diagnostics"
      }
    ],
    "configuration": {
      "title": "DevPulse",
      "properties": {
        "devpulse.apiUrl": {
          "type": "string",
          "default": "http://localhost:3000/api/v1",
          "description": "DevPulse backend base URL (example: http://localhost:3000/api/v1)",
          "scope": "machine"
        },
        "devpulse.dashboardUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "DevPulse dashboard URL (used by quick-menu links)",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@devpulse/env": "workspace:*",
    "@devpulse/eslint-config": "workspace:*",
    "@devpulse/lib": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "~22.19.17",
    "@types/vscode": "1.93.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
