{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "devpulse.devpulse",
  "displayName": "DevPulse",
  "description": "DevPulse: time-tracking and workflow analytics for developers",
  "version": "0.0.1",
  "publisher": "devpulse",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devpulse.devpulse.helloWorld",
        "title": "DevPulse: Hello World"
      },
      {
        "command": "devpulse.devpulse.setApiKey",
        "title": "DevPulse: Set API Key"
      }
    ],
    "configuration": {
      "title": "DevPulse",
      "properties": {
        "devpulse.apiUrl": {
          "type": "string",
          "default": "http://localhost:3000/api/v1",
          "description": "DevPulse backend base URL (example: http://localhost:3000/api/v1)",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@devpulse/lib": "workspace:*",
    "@devpulse/env": "workspace:*",
    "@devpulse/eslint-config": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "~22.19.17",
    "@types/vscode": "^1.115.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
