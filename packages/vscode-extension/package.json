{
  "name": "devpulse.devpulse",
  "displayName": "DevPulse",
  "description": "DevPulse: time-tracking and workflow analytics for developers",
  "version": "0.0.1",
  "publisher": "devpulse",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devpulse.devpulse.helloWorld",
        "title": "DevPulse: Hello World"
      },
      {
        "command": "devpulse.devpulse.setApiKey",
        "title": "DevPulse: Set API Key"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@devpulse/eslint-config": "workspace:*",
    "@types/vscode": "^1.115.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
