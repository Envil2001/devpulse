{
  "name": "devpulse.devpulse",
  "displayName": "DevPulse",
  "version": "0.0.1",
  "description": "DevPulse: time-tracking and workflow analytics for developers",
  "categories": [
    "Other"
  ],
  "publisher": "devpulse",
  "type": "module",
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "vscode-test",
    "vscode:prepublish": "pnpm run compile",
    "watch": "tsc -watch -p ./"
  },
  "contributes": {
    "commands": [
      {
        "command": "devpulse.devpulse.helloWorld",
        "title": "DevPulse: Hello World"
      },
      {
        "command": "devpulse.devpulse.setApiKey",
        "title": "DevPulse: Set API Key"
      }
    ],
    "configuration": {
      "title": "DevPulse",
      "properties": {
        "devpulse.apiUrl": {
          "type": "string",
          "default": "http://localhost:3000/api/v1",
          "description": "DevPulse backend base URL (example: http://localhost:3000/api/v1)"
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@devpulse/env": "workspace:*",
    "@devpulse/eslint-config": "workspace:*",
    "@devpulse/lib": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "~22.19.17",
    "@types/vscode": "^1.115.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "vscode": "^1.85.0"
  }
}
